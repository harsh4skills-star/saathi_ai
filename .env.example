# ---- Required ----
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ---- Optional: persistence ----
# Leave blank to use local SQLite (data/elder.db). Fine for local use and testing.
# Set this to a Supabase/Postgres connection string for a public deployment
# on Streamlit Community Cloud, whose local disk is wiped on every restart.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ---- Optional: Family Bridge (weekly digest email) ----
# Uses a free Gmail account + an "app password" (not your normal password).
# Create one at https://myaccount.google.com/apppasswords
SENDER_EMAIL=
SENDER_APP_PASSWORD=
FAMILY_EMAIL=
